---
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Support for Beanie — Tiny Big Labs" />
    <title>Support · Beanie · Tiny Big Labs</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  </head>

  <body>
    <main>
      <article>
        <header>
          <a href="/" class="wordmark">tiny big labs</a>
          <h1>Beanie Support</h1>
          <p class="meta">We're here to help</p>
        </header>

        <section>
          <h2>Get in touch</h2>
          <p>Have a question, found a bug, or want to share feedback? Send us a message and we'll get back to you.</p>
          <form action="https://formspree.io/f/meenvyne" method="POST" class="contact-form">
            <input type="email" name="email" placeholder="Your email" required />
            <textarea name="message" placeholder="Your message" rows="5" required></textarea>
            <button type="submit">Send message</button>
          </form>
        </section>

        <footer>
          <p>Tiny Big Labs<br />London, United Kingdom</p>
        </footer>
      </article>
    </main>
  </body>
</html>

<style>
  body {
    display: flex;
    justify-content: center;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 4rem 1.5rem;
    color: #e0e0e0;
    font-family: system-ui, -apple-system, sans-serif;
  }

  main {
    width: 100%;
    max-width: 680px;
  }

  article {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #222;
  }

  .wordmark {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    color: #666;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .wordmark:hover {
    color: #aaa;
  }

  h1 {
    margin: 0;
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-size: 2.25rem;
    font-weight: 400;
    color: #fff;
    line-height: 1.2;
  }

  .meta {
    margin: 0;
    font-size: 0.85rem;
    color: #555;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  h2 {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #777;
  }

  p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #bbb;
  }

  a {
    color: #aaa;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  a:hover {
    color: #fff;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .contact-form input,
  .contact-form textarea {
    background: #111;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    color: #e0e0e0;
    font-size: 0.9rem;
    font-family: inherit;
    padding: 0.6rem 0.85rem;
    width: 100%;
    outline: none;
    transition: border-color 0.2s;
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: #555;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #444;
  }

  .contact-form button {
    align-self: flex-start;
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 6px;
    color: #ccc;
    cursor: pointer;
    font-size: 0.85rem;
    font-family: inherit;
    padding: 0.55rem 1.25rem;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .contact-form button:hover {
    background: #222;
    border-color: #555;
    color: #fff;
  }

  footer {
    padding-top: 2rem;
    border-top: 1px solid #222;
  }

  footer p {
    font-size: 0.85rem;
    color: #444;
    line-height: 1.6;
  }
</style>
