---
import Base from '../layouts/Base.astro';
import DotPattern from '../components/DotPattern.astro';
---

<Base title="Tiny Big Labs" description="Tiny Big Labs">
  <DotPattern />

  <main>
    <h1 class="title">
      <span class="tiny">tiny</span>
      <span class="big">big</span>
      <span class="labs">labs</span>
    </h1>
  </main>
</Base>

<script>
  // fire a background ripple from "labs" as it starts to flicker (71% into its 7s cycle)
  const labs = document.querySelector<HTMLElement>('.labs')!;
  const pulse = () => {
    const r = labs.getBoundingClientRect();
    window.dispatchEvent(new CustomEvent('bg-pulse', { detail: { x: r.left + r.width / 2, y: r.top + r.height / 2 } }));
  };
  const schedule = () => setTimeout(pulse, 7000 * 0.71);
  schedule();
  labs.addEventListener('animationiteration', schedule);
</script>

<style>
  body {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100dvh;
    height: -webkit-fill-available;
  }

  main {
    position: relative;
    z-index: 10;
  }

  .title {
    margin: 0;
    white-space: nowrap;
    word-spacing: -0.3em;
    font-size: 8vmin;
    font-family: 'iA Writer Quattro V', 'DM Mono', monospace;
    font-weight: 400;
    user-select: none;
    -webkit-user-select: none;
  }

  .tiny {
    color: #aaa;
    font-weight: 400;
  }

  .big {
    font-weight: 550;
    background-image: linear-gradient(to top, #fff, #bbb);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .labs {
    display: inline-block;
    font-weight: 700;
    color: white;
    text-shadow:
      0 0 0.5vmin #fff,
      0 0.5vmin 1.5vmin #faa,
      0 -0.5vmin 1.5vmin #acf,
      0 -1.5vmin 3vmin #fff,
      0 0 10vmin #fff;
    animation: labs-flicker 7s infinite;
  }

  @keyframes labs-flicker {
    0%, 70%  { opacity: 1; }
    71%  { opacity: 0.5; }
    72%  { opacity: 1; }
    73%  { opacity: 0.2; }
    74%  { opacity: 0.9; }
    75%  { opacity: 0.1; }
    76%  { opacity: 1; }
    77%  { opacity: 0.6; }
    78%  { opacity: 1; }
    79%  { opacity: 0.3; }
    80%  { opacity: 1; }
    100% { opacity: 1; }
  }
</style>
