---
import Base from '../layouts/Base.astro';
import DotPattern from '../components/DotPattern.astro';
import Symbol from '../components/Symbol.astro';
---

<Base title="Tiny Big Labs" description="Small apps that do one thing well. Made in London.">
  <DotPattern />

  <main>
    <Symbol class="symbol" />
    <h1 class="wordmark">
      <span class="w1">tiny</span> <span class="w2">big</span> <span class="w3">labs</span>
    </h1>
  </main>
</Base>

<script>
  // The symbol "taps" once per 7s cycle (71% in); a background ripple leaves from the nucleus as it does.
  const symbol = document.querySelector<SVGSVGElement>('.symbol')!;
  const pulse = () => {
    const r = symbol.getBoundingClientRect();
    // the nucleus is the centre of the atom
    window.dispatchEvent(new CustomEvent('bg-pulse', { detail: { x: r.left + r.width / 2, y: r.top + r.height / 2 } }));
  };
  const schedule = () => setTimeout(pulse, 7000 * 0.71);
  schedule();
  symbol.addEventListener('animationiteration', schedule);
</script>

<style>
  body {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100dvh;
    height: -webkit-fill-available;
  }

  main {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4.25vmin;
    user-select: none;
    -webkit-user-select: none;
  }

  main :global(.symbol) {
    width: 15vmin;
    height: 15vmin;
    color: var(--white);
    animation: symbol-tap 7s infinite;
  }

  .wordmark {
    margin: 0;
    font-size: 8vmin;
    font-weight: 400;
  }

  @keyframes symbol-tap {
    0%, 69% { transform: scale(1); }
    71%     { transform: scale(0.93); }
    76%     { transform: scale(1.02); }
    82%     { transform: scale(1); }
    100%    { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    main :global(.symbol) { animation: none; }
  }
</style>
