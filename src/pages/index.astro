---
import DotPattern from '../components/DotPattern.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Tiny Big Labs" />
    <title>Tiny Big Labs</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  </head>

  <body>
    <DotPattern />

    <main>
      <div class="title">
        <p>tiny</p>
        <p><span class="gradient-text">big</span></p>
        <p>labs</p>
      </div>
    </main>
  </body>
</html>

<style>
  body {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100dvh;
    height: -webkit-fill-available;
  }

  main {
    position: relative;
    z-index: 10;
  }

  .title {
    text-align: center;
    font-size: 9vmin;
    line-height: 8.5vmin;
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
  }

  .title p {
    margin: 0;
  }

  /* tiny — dark, bold, compressed */
  .title p:nth-child(1) {
    transform: scaleX(0.9);
    font-weight: bold;
    color: #333;
    text-shadow: 0 1px 0 #666;
  }

  /* big — gradient fill, slightly expanded */
  .title p:nth-child(2) {
    transform: scaleX(1.15);
    position: relative;
    color: transparent;
    text-shadow: 0 1vmin 4vmin rgba(255,255,255,0.15);
  }

  .gradient-text {
    background-image: linear-gradient(to top, #ccc, #444);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* labs — white with glow + periodic flicker */
  .title p:nth-child(3) {
    color: white;
    transform: scaleX(1.4);
    text-shadow:
      0 0 0.5vmin #fff,
      0 0.5vmin 1.5vmin #faa,
      0 -0.5vmin 1.5vmin #acf,
      0 -1.5vmin 3vmin #fff,
      0 0 10vmin #fff;
    animation: labs-flicker 7s infinite;
  }

  @keyframes labs-flicker {
    /* stable for most of the cycle */
    0%, 70%  { opacity: 1; }
    /* flicker burst starts at 70% */
    71%  { opacity: 0.5; }
    72%  { opacity: 1; }
    73%  { opacity: 0.2; }
    74%  { opacity: 0.9; }
    75%  { opacity: 0.1; }
    76%  { opacity: 1; }
    77%  { opacity: 0.6; }
    78%  { opacity: 1; }
    79%  { opacity: 0.3; }
    80%  { opacity: 1; }
    /* settle back to stable */
    100% { opacity: 1; }
  }
</style>
