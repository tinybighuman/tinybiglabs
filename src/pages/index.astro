---
import Base from '../layouts/Base.astro';
import DotPattern from '../components/DotPattern.astro';
---

<Base title="Tiny Big Labs" description="Tiny Big Labs">
  <DotPattern />

  <main>
    <div class="title">
      <p>tiny</p>
      <p><span class="gradient-text">big</span></p>
      <p>labs</p>
    </div>
  </main>
</Base>

<style>
  body {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100dvh;
    height: -webkit-fill-available;
  }

  main {
    position: relative;
    z-index: 10;
  }

  .title {
    text-align: center;
    font-size: 9vmin;
    line-height: 8.5vmin;
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-optical-sizing: auto;
    user-select: none;
    -webkit-user-select: none;
  }

  .title p {
    margin: 0;
  }

  .title p:nth-child(1) {
    transform: scaleX(0.9);
    color: #aaa;
    font-weight: 300;
  }

  .title p:nth-child(2) {
    transform: scaleX(1.15);
    position: relative;
    color: transparent;
    text-shadow: 0 1vmin 4vmin rgba(255,255,255,0.15);
  }

  .gradient-text {
    background-image: linear-gradient(to top, #fff, #bbb);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .title p:nth-child(3) {
    color: white;
    transform: scaleX(1.4);
    text-shadow:
      0 0 0.5vmin #fff,
      0 0.5vmin 1.5vmin #faa,
      0 -0.5vmin 1.5vmin #acf,
      0 -1.5vmin 3vmin #fff,
      0 0 10vmin #fff;
    animation: labs-flicker 7s infinite;
  }

  @keyframes labs-flicker {
    0%, 70%  { opacity: 1; }
    71%  { opacity: 0.5; }
    72%  { opacity: 1; }
    73%  { opacity: 0.2; }
    74%  { opacity: 0.9; }
    75%  { opacity: 0.1; }
    76%  { opacity: 1; }
    77%  { opacity: 0.6; }
    78%  { opacity: 1; }
    79%  { opacity: 0.3; }
    80%  { opacity: 1; }
    100% { opacity: 1; }
  }
</style>
