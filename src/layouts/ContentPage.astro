---
import Base from './Base.astro';
import Symbol from '../components/Symbol.astro';
import '../styles/content.css';

interface Props {
  title: string;
  description?: string;
  heading: string;
  subheading?: string;
}

const { title, description = '', heading, subheading } = Astro.props;
---

<Base title={title} description={description}>
  <main>
    <article>
      <header>
        <a href="/" class="brand" aria-label="Tiny Big Labs home">
          <Symbol size={24} />
          <span class="wordmark"><span class="w1">tiny</span> <span class="w2">big</span> <span class="w3">labs</span></span>
        </a>
        <h1>{heading}</h1>
        {subheading && <p class="meta">{subheading}</p>}
      </header>
      <slot />
      <footer>
        <p>tiny big labs · made in london</p>
      </footer>
    </article>
  </main>
</Base>
