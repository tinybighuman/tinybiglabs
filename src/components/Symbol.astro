---
// Master symbol from the brand guide: 40×40 squircle (r 11) on a 48 grid, hole Ø9 cut out at 32,32.
interface Props {
  size?: number | string;
  class?: string;
}
const { size = 48, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 48 48" role="img" aria-label="Tiny Big Labs symbol">
  <path fill-rule="evenodd" fill="currentColor" d="M15 4h18a11 11 0 0 1 11 11v18a11 11 0 0 1-11 11H15A11 11 0 0 1 4 33V15A11 11 0 0 1 15 4zM32 27.5a4.5 4.5 0 1 0 0 9a4.5 4.5 0 1 0 0-9z" />
</svg>
